# Expected keys for .env.local (copy this file to .env.local and fill in the
# values; .env.local is gitignored and must never be committed).
#
# Read by: docker compose (always pass `--env-file .env.local`) and every
# service's application.yml (spring.config.import: optional:file:../.env.local).
# Required keys have no default anywhere: a service or compose fails to start
# without them.

# --- Required ---------------------------------------------------------------

# Postgres superuser password for the docker compose container.
POSTGRES_PASSWORD=
# Password the four services use to connect to that Postgres (same value).
DB_PASSWORD=
# RabbitMQ password, used both by docker compose and by the services.
RABBITMQ_PASSWORD=
# HS256 signing secret, ONE value shared by all four services: auth-service
# signs tokens with it, recycler/collection/reporting-service validate them
# offline with it. At least 32 bytes. Must be identical everywhere.
JWT_SECRET=

# --- auth-service only --------------------------------------------------------

# On first startup with an empty staff_user table, auth-service creates this
# account with a randomly generated password logged once at WARN level.
# There is deliberately no ADMIN_BOOTSTRAP_PASSWORD variable.
ADMIN_BOOTSTRAP_EMAIL=

# --- Optional (defaults shown) ------------------------------------------------

# DB_URL=jdbc:postgresql://localhost:5433/esg_trazabilidad
# DB_USERNAME=esg
# POSTGRES_USER=esg
# POSTGRES_DB=esg_trazabilidad
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=esg
