<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pe.esgtrazabilidad</groupId>
    <artifactId>esg-trazabilidad-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>esg-trazabilidad</name>
    <description>Plataforma de trazabilidad ESG para recicladores formalizados en Lima Metropolitana</description>

    <modules>
        <module>shared-kernel</module>
        <module>recycler-service</module>
        <module>collection-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Needed for @PathVariable/@RequestParam to resolve by parameter name
             via reflection without every one needing an explicit name= value. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <!-- Not part of the Spring Boot BOM; pinned here so every module that
             wires Swagger UI later shares one version. -->
        <springdoc-openapi.version>2.6.0</springdoc-openapi.version>
        <!-- Not part of the Spring Boot BOM either; pinned here so shared-kernel
             (OutboxDispatcher) and both services (their own LockProvider beans)
             share one version. -->
        <shedlock.version>7.10.1</shedlock.version>
        <!-- Overrides Spring Boot 3.3.5's managed Testcontainers version (1.19.8):
             its Windows npipe transport hardcodes an old Docker API version and
             ignores DOCKER_API_VERSION, breaking against recent Docker Engines.
             The bug persists through the 1.x line (confirmed against 1.20.4) —
             needs the 2.x series, per Rancher Desktop's Testcontainers troubleshooting docs. -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Declared before spring-boot-dependencies so it wins for org.testcontainers:*:
                 spring-boot-dependencies imports testcontainers-bom as a NESTED import,
                 which resolves ${testcontainers.version} against its own internal value at
                 import time — overriding that property in this pom has no effect on it. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
