# Expected keys for .env.local (copy this file to .env.local and fill in the
# values; .env.local is gitignored and must never be committed).
#
# Read by: docker compose (always pass `--env-file .env.local`) and every
# service's application.yml (spring.config.import: optional:file:../.env.local).
# Required keys have no default anywhere: a service or compose fails to start
# without them.

# --- Required ---------------------------------------------------------------

# Postgres superuser password for the docker compose container.
POSTGRES_PASSWORD=
# Password the four services use to connect to that Postgres (same value).
DB_PASSWORD=
# RabbitMQ password, used both by docker compose and by the services.
RABBITMQ_PASSWORD=
# HS256 signing secret, ONE value shared by all four services: auth-service
# signs tokens with it, recycler/collection/reporting-service validate them
# offline with it. At least 32 bytes. Must be identical everywhere.
JWT_SECRET=

# --- reporting-service only ---------------------------------------------------

# Who answers SUNAT's RUC register: decolecta (real) or none (every lookup "does
# not answer"; development and tests only, the service refuses it when RENDER=true).
# No default: reporting-service does not start without it.
RUC_LOOKUP_PROVIDER=
# Decolecta API token. Required when RUC_LOOKUP_PROVIDER=decolecta (DECOLECTA_TOKEN
# is accepted as an alias). Never commit it, log it or paste it in a chat.
RUC_LOOKUP_TOKEN=
# SIGERSOL Municipal provider for the district context on certificates. No default:
# reporting-service does not start without it. "none" = every district reads "no disponible";
# "sigersol" calls the public SIGERSOL Municipal service and needs SIGERSOL_MUNICIPAL_BASE_URL.
SIGERSOL_MUNICIPAL_PROVIDER=none
# SIGERSOL_MUNICIPAL_BASE_URL=https://sistemas.minam.gob.pe/srv-sigersol/rest/

# --- auth-service only --------------------------------------------------------

# On first startup with an empty staff_user table, auth-service creates this
# account with a randomly generated password logged once at WARN level.
# There is deliberately no ADMIN_BOOTSTRAP_PASSWORD variable.
ADMIN_BOOTSTRAP_EMAIL=
# Password recovery ("Olvidé mi contraseña"). None of these has a default: auth-service
# does not start without them.
# Who sends the email: appsscript (a Google Apps Script web app, production), fake (keeps
# the emails in memory; development and tests) or none. fake and none are refused when
# RENDER=true and PASSWORD_RESET_EMAIL_ENABLED=true.
EMAIL_PROVIDER=fake
# Emergency switch: true lets recovery send emails, false sends none.
PASSWORD_RESET_EMAIL_ENABLED=true
# Secret of the HMAC that protects the codes in the database. At least 32 bytes, random.
# Never commit it, log it or paste it in a chat.
PASSWORD_RESET_PEPPER=
# Only with EMAIL_PROVIDER=appsscript: the web app's URL (it must start with
# https://script.google.com/macros/s/) and the secret shared with the script (at least 32
# characters, the same value as the script's WEBHOOK_SECRET property).
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_SECRET=

# --- Optional (defaults shown) ------------------------------------------------

# DB_URL=jdbc:postgresql://localhost:5433/esg_trazabilidad
# DB_USERNAME=esg
# POSTGRES_USER=esg
# POSTGRES_DB=esg_trazabilidad
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USER=esg
# CloudAMQP needs its instance's vhost and TLS (port 5671); local compose uses
# "/" and plaintext 5672. Not read by auth-service, which uses no AMQP.
# RABBITMQ_VHOST=/
# RABBITMQ_SSL_ENABLED=false
# HTTP port. Render injects it in production; locally each service defaults to
# its own fixed port (recycler 8081, collection 8082, reporting 8083, auth 8084).
# PORT=
# Browser origins allowed to call the APIs, comma separated. Empty allows none;
# "*" is refused at startup. In production it goes in esg-shared.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Production ---------------------------------------------------------------

# Production values are never in a file: they live in Render's dashboard, in the
# esg-shared environment group (plus ADMIN_BOOTSTRAP_EMAIL on auth-service only).
# See README.md (Cómo desplegarlo) and the portal chapter "Despliegue paso a paso".
