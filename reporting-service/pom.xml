<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.esgtrazabilidad</groupId>
        <artifactId>esg-trazabilidad-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>reporting-service</artifactId>
    <packaging>jar</packaging>

    <name>reporting-service</name>
    <description>Certificados ESG de trazabilidad: empresas rastreadas, datos oficiales SIGERSOL, emisión y exportación PDF/CSV</description>

    <dependencies>
        <dependency>
            <groupId>pe.esgtrazabilidad</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- No shedlock-provider-jdbc-template here, unlike recycler-service/
             collection-service: this module runs no @Scheduled job (it never
             publishes, so OutboxDispatcher never activates; see
             SPEC-reporting-service.md's Resolved Decisions) and needs no
             ShedLock table of its own. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Pinned to the 5.x line: 6.0.1 references a Jackson 3 support
                 class not present with Spring Boot 3.3.5's Jackson 2.x. -->
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>reporting-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- Keeps target/reporting-service.jar as a plain jar so
                                 failsafe's forked JVM classpath still resolves project
                                 classes during `mvn verify` — same reasoning as the
                                 other two services' pom.xml. -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Every @SpringBootTest IT now boots a real
                         CollectionRegisteredEventListener (Task 48): Spring AMQP's
                         listener container tries to connect to whatever
                         spring.rabbitmq.* resolves to (the real local broker, since
                         these Postgres-only IT tests don't override it) at context
                         startup by default. Doesn't hard-fail (Spring AMQP retries
                         lazily in the background), but logs noisy connection-refused
                         stack traces and makes tests implicitly depend on a
                         locally-running broker, which isn't hermetic. Same fix as
                         recycler-service's pom.xml (Task 30): auto-startup=false stops
                         the listener container from connecting/consuming at context
                         startup; Task 49's real broker-integration test opts back in
                         locally via its own @TestPropertySource. -->
                    <systemPropertyVariables>
                        <spring.rabbitmq.listener.simple.auto-startup>false</spring.rabbitmq.listener.simple.auto-startup>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
