<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.esgtrazabilidad</groupId>
        <artifactId>esg-trazabilidad-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>recycler-service</artifactId>
    <packaging>jar</packaging>

    <name>recycler-service</name>
    <description>Gestión de recicladores, asociaciones (Ley N.° 29419) y certificaciones</description>

    <dependencies>
        <dependency>
            <groupId>pe.esgtrazabilidad</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Concrete LockProvider backed by this service's own DataSource,
             pointed at shedlock_recycler via withTableName(...): never a
             table literally named "shedlock" (see SPEC-cross-service-events.md's
             Resolved Decisions). shedlock-spring (the @SchedulerLock annotation)
             comes transitively via shared-kernel. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Pinned to the 5.x line: 6.0.1 references a Jackson 3 support
                 class not present with Spring Boot 3.3.5's Jackson 2.x. -->
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>recycler-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- Keeps target/recycler-service.jar as a plain jar so
                                 failsafe's forked JVM classpath still resolves project
                                 classes during `mvn verify` — otherwise repackage
                                 replaces it in place with the nested BOOT-INF/classes
                                 layout before the integration-test phase runs. The
                                 executable jar is still produced, as
                                 recycler-service-exec.jar. -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Every @SpringBootTest IT now boots a real OutboxDispatcher
                         (an OutboxRepository bean exists since Task 29), each on its
                         own 5s @Scheduled tick. Without this, a tick firing after a
                         given test class's own Testcontainers Postgres has already
                         been torn down logs a noisy connection-refused stack trace:
                         harmless to the build result, but real test-isolation noise
                         worth suppressing globally rather than patching every IT test
                         class with its own @TestPropertySource one at a time. Same
                         fix as collection-service's Task 27. -->
                    <systemPropertyVariables>
                        <esg.events.outbox-dispatcher.enabled>false</esg.events.outbox-dispatcher.enabled>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
