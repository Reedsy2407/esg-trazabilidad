<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE labels SYSTEM "https://resources.jetbrains.com/writerside/1.0/labels-list.dtd">
<labels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/labels.xsd">

    <!-- Servicio dueño del topic (label principal). -->
    <primary-label id="auth" name="auth-service" short-name="auth">Acceso del personal y emisión de tokens.</primary-label>
    <primary-label id="recycler" name="recycler-service" short-name="recycler">Asociaciones, recicladores y certificaciones.</primary-label>
    <primary-label id="collection" name="collection-service" short-name="collection">Vecinos, empresas, cronogramas y recojos.</primary-label>
    <primary-label id="reporting" name="reporting-service" short-name="reporting">Certificados ESG y contexto SIGERSOL.</primary-label>

    <!-- Estabilidad de un endpoint (ver «Etiquetas de estabilidad» en cada página de referencia). -->
    <secondary-label id="estable" name="Estable" color="green">En uso por la consola, cubierto por pruebas y sin cambios previstos.</secondary-label>
    <secondary-label id="reciente" name="Reciente" color="tangerine">Añadido o cambiado entre M7 y M10; puede ajustarse.</secondary-label>
    <secondary-label id="interno" name="Interno" color="purple">Existe, pero la consola no lo usa.</secondary-label>

    <!-- Estado de una decisión (ADR). No se escribe a mano: gen-adr-toc.mjs lo deriva
         de la línea "Estado" de cada ADR al construir. -->
    <secondary-label id="adr-pendiente" name="Aceptada, pendiente de implementación" color="tangerine">Decisión aceptada que el código todavía no refleja.</secondary-label>
    <secondary-label id="adr-implementada" name="Implementada" color="green">La decisión ya está en el código.</secondary-label>
    <secondary-label id="adr-descartada" name="Descartada" color="purple">Se evaluó y no se adopta; queda registrada para no volver a discutirla.</secondary-label>
    <secondary-label id="adr-reemplazada" name="Reemplazada" color="red">Ya no aplica; ver la decisión que la reemplaza.</secondary-label>
</labels>
