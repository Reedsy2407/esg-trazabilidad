<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.esgtrazabilidad</groupId>
        <artifactId>esg-trazabilidad-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shared-kernel</artifactId>
    <packaging>jar</packaging>

    <name>shared-kernel</name>
    <description>Bloques transversales compartidos: manejo de errores, estrategia de eventos, generación de IDs</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Bare spring-web (no MVC autoconfig, no embedded server): needed for
             HttpStatus/ProblemDetail/@RestControllerAdvice, kept out of spring-boot-starter-web. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- org.springframework.dao.* (DataIntegrityViolationException and the
             rest of the DataAccessException hierarchy) lives in spring-tx, not
             spring-core/spring-web — needed for the generic DB-conflict fallback. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- org.springframework.data.domain.Page/Pageable, needed by PageResponse<T>
             (shared list-endpoint wrapper) — bare spring-data-commons, not the full
             spring-boot-starter-data-jpa (no persistence concerns belong here). -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- OutboxDispatcher's transport: RabbitTemplate for publishing. Both
             services get this transitively, but neither eagerly connects to
             the broker at boot: CachingConnectionFactory is lazy by default,
             and nothing here publishes or listens until later tasks wire it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- @SchedulerLock annotation + LockProvider interface only: the
             concrete JDBC-backed provider (shedlock-provider-jdbc-template)
             is added per-service in Tasks 27/29, wired to that service's own
             DataSource. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
        </dependency>

        <!-- RabbitListenerConfig's Jackson2JsonMessageConverter needs
             ObjectMapper at compile time: not pulled in transitively by
             spring-boot-starter-amqp (spring-rabbit treats Jackson as
             optional). Both services already have this via
             spring-boot-starter-web, but shared-kernel's own build needs
             it declared directly. Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
