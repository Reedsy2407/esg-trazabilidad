<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pe.esgtrazabilidad</groupId>
    <artifactId>esg-trazabilidad-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>esg-trazabilidad</name>
    <description>Plataforma de trazabilidad ESG para recicladores formalizados en Lima Metropolitana</description>

    <modules>
        <module>shared-kernel</module>
        <module>recycler-service</module>
        <module>collection-service</module>
        <module>reporting-service</module>
        <module>auth-service</module>
        <!-- Last on purpose: runs the other services' packaged jars as real
             processes (see e2e-tests/pom.xml). -->
        <module>e2e-tests</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Needed for @PathVariable/@RequestParam to resolve by parameter name
             via reflection without every one needing an explicit name= value. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <!-- Not part of the Spring Boot BOM; pinned here so every module that
             wires Swagger UI later shares one version. -->
        <springdoc-openapi.version>2.6.0</springdoc-openapi.version>
        <!-- Not part of the Spring Boot BOM either; pinned here so shared-kernel
             (OutboxDispatcher) and both services (their own LockProvider beans)
             share one version. -->
        <shedlock.version>7.10.1</shedlock.version>
        <!-- Overrides Spring Boot 3.3.5's managed Testcontainers version (1.19.8):
             its Windows npipe transport hardcodes an old Docker API version and
             ignores DOCKER_API_VERSION, breaking against recent Docker Engines.
             The bug persists through the 1.x line (confirmed against 1.20.4) —
             needs the 2.x series, per Rancher Desktop's Testcontainers troubleshooting docs. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- auth-service's login rate limit (SPEC-deployment.md). Not in the
             Spring Boot BOM. -->
        <bucket4j.version>8.20.0</bucket4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Declared before spring-boot-dependencies so it wins for org.testcontainers:*:
                 spring-boot-dependencies imports testcontainers-bom as a NESTED import,
                 which resolves ${testcontainers.version} against its own internal value at
                 import time — overriding that property in this pom has no effect on it. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Mockito's inline mock maker needs a Java agent. Left to itself it
         attaches Byte Buddy's agent at runtime (dynamic attach), which JDK 21
         already warns about and which broke on a GitHub runner image
         (Attach Listener NPE, "Could not initialize plugin: MockMaker").
         Loading the agent with -javaagent from the start is what Mockito
         documents for JDK 21+. Mockito 5.11 (managed by Spring Boot 3.3.5)
         has no Premain-Class yet, so the agent is byte-buddy-agent, the same
         one it would self-attach. dependency:properties exposes that jar's
         path as ${net.bytebuddy:byte-buddy-agent:jar}; e2e-tests has no
         Mockito and turns the argLine off in its own pom. -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Xshare:off</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>mockito-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
