<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pe.esgtrazabilidad</groupId>
        <artifactId>esg-trazabilidad-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shared-kernel</artifactId>
    <packaging>jar</packaging>

    <name>shared-kernel</name>
    <description>Bloques transversales compartidos: manejo de errores, estrategia de eventos, generación de IDs</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Bare spring-web (no MVC autoconfig, no embedded server): needed for
             HttpStatus/ProblemDetail/@RestControllerAdvice, kept out of spring-boot-starter-web. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- org.springframework.dao.* (DataIntegrityViolationException and the
             rest of the DataAccessException hierarchy) lives in spring-tx, not
             spring-core/spring-web — needed for the generic DB-conflict fallback. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- org.springframework.data.domain.Page/Pageable, needed by PageResponse<T>
             (shared list-endpoint wrapper) — bare spring-data-commons, not the full
             spring-boot-starter-data-jpa (no persistence concerns belong here). -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- OutboxDispatcher's transport: RabbitTemplate for publishing. Both
             services get this transitively, but neither eagerly connects to
             the broker at boot: CachingConnectionFactory is lazy by default,
             and nothing here publishes or listens until later tasks wire it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- JwtSecurityConfig's JwtDecoder/NimbusJwtDecoder, plus
             AuthenticationEntryPoint/AccessDeniedHandler (spring-security-web,
             pulled in transitively by this starter). scope=provided
             deliberately: this starter's mere PRESENCE on a service's
             classpath (regardless of any bean registration) triggers Spring
             Boot's own SecurityAutoConfiguration default lockdown (HTTP
             Basic + a generated password on every endpoint), confirmed
             the hard way (a @WebMvcTest against recycler-service started
             getting 403 the moment this was declared at normal compile
             scope here, even with JwtSecurityConfig itself not registered
             anywhere). provided scope means shared-kernel compiles against
             it, but it does NOT propagate transitively to consumers; each
             service that wants JWT support (auth-service, and later
             recycler-service/collection-service/reporting-service's own
             retrofit tasks) adds it explicitly to its OWN pom.xml at normal
             scope, at the same time it adds its own SecurityFilterChain
             bean, so Spring Boot's default never gets a chance to apply. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @SchedulerLock annotation + LockProvider interface only: the
             concrete JDBC-backed provider (shedlock-provider-jdbc-template)
             is added per-service in Tasks 27/29, wired to that service's own
             DataSource. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
        </dependency>

        <!-- RabbitListenerConfig's Jackson2JsonMessageConverter needs
             ObjectMapper at compile time: not pulled in transitively by
             spring-boot-starter-amqp (spring-rabbit treats Jackson as
             optional). Both services already have this via
             spring-boot-starter-web, but shared-kernel's own build needs
             it declared directly. Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
